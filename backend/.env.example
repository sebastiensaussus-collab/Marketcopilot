# Copy this file to .env and fill in your keys.

# Required for the synthesis layer. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: without this, macro backdrop context (fed funds rate, CPI, 10y yield,
# unemployment) is skipped and equity theses synthesize without it. Free, instant
# signup at https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
